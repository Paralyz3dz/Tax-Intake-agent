# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/taxagent
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda

# --- LLM provider: chat agent, note reader, tax questions, document reading (src/config.py)
# Any OpenAI-compatible server. The old OPENAI_* names still work.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_EXTRACT_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1      # OpenRouter / DeepSeek / Azure ...
# LLM_BASE_URL=http://localhost:11434/v1         # local Ollama: no key, nothing leaves the machine

# --- Ollama: query embeddings for retrieval (src/rag/retriever.py)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Guided interview switches: on / off
# off = no live retrieval (no DB / Ollama needed); prebuilt guide passages are still shown
TAX_AGENT_RETRIEVAL=on
# off = exact answers only, never call the model
TAX_AGENT_LLM=on

# Interview storage for a local run (default logs/interviews.sqlite3). Docker always uses its volume.
# TAX_AGENT_INTERVIEW_DB_PATH=
# TAX_AGENT_INTERVIEW_DATABASE_URL=

# MCP tunnel mode token (docs/mcp.md): python src/mcp_server/server.py --new-token
TAX_AGENT_MCP_TOKEN=

# --- Public site (docs/deploy.md). local = no sign-in, for your own machine only.
TAX_AGENT_MODE=local
# python -m src.app.auth secret
TAX_AGENT_SESSION_SECRET=
# name:hash pairs, comma-separated; make a hash with: python -m src.app.auth hash
# Keep the single quotes: the hash contains $, which Docker Compose would otherwise replace.
TAX_AGENT_PREPARERS=''
# invite codes for the client pages, comma-separated; remove one to sign its visitors out
TAX_AGENT_INVITE_CODES=
TAX_AGENT_LLM_CALLS_PER_VISITOR=200
TAX_AGENT_LLM_CALLS_PER_DAY=2000
# delete interviews not updated for this many days (0 = keep)
TAX_AGENT_RETENTION_DAYS=0
# docker compose --profile https: the server's host name (an IP works via sslip.io: 203-0-113-7.sslip.io)
DOMAIN=
